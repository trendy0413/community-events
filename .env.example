# Copy to .env for local runs. The npm scripts load it when it exists.
# Any PostgreSQL 16 works. The default is the Docker database from `npm run db:up`.
DATABASE_URL=postgres://community_events:community_events@localhost:15432/community_events

# Optional. If DATABASE_URL goes through a connection pooler, set the direct
# connection here; `npm run migrate` prefers it.
# DATABASE_URL_UNPOOLED=

# Optional. Tests empty their database at the start, so they never use
# DATABASE_URL itself: by default they use "<its database name>_test" on the
# same server, created if missing. Set this to use another database.
# TEST_DATABASE_URL=

# The only identity mode in this build (SPEC section 9). Without it the server
# refuses to start (R9). `npm run dev` and the test scripts already set it.
# AUTH_MODE=dev-stub

PORT=3000
# 127.0.0.1 keeps the dev identity stub off the network. Use 0.0.0.0 only inside a container.
HOST=127.0.0.1
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
