# Copy to .env for local runs. `npm run dev` and the test scripts load it when it exists.
# Any PostgreSQL 16 works. The default is the Docker database from `npm run db:up`.
DATABASE_URL=postgres://community_events:community_events@localhost:15432/community_events
PORT=3000
# 127.0.0.1 keeps the dev identity stub off the network. Use 0.0.0.0 only inside a container.
HOST=127.0.0.1
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
